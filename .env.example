# Boot settings. Routes, targets and retention live in the database, per user.
PUBLIC_URL=https://ghook.example.com
LISTEN_ADDR=:8080
DB_PATH=/data/ghook.db

# Google web OAuth client (JSON). One client is shared by every user.
# Authorized redirect URI: ${PUBLIC_URL}/admin/google/callback
GOOGLE_CLIENT_FILE=/run/secrets/google-client.json
# GOOGLE_CLIENT_JSON=

# Shared Pub/Sub. Incoming notifications are routed by emailAddress.
# PUBSUB_PROJECT=  # taken from the service account JSON when empty
PUBSUB_TOPIC=gmail-inbox
PUBSUB_SUBSCRIPTION=ghook-pull
PUBSUB_SA_FILE=/run/secrets/pubsub-sa.json
# PUBSUB_SA_JSON=

# Instance key (KEK) that wraps each per-user data key. When empty, ghook
# writes /data/secrets.key on first start. Prefer the file if you want to
# run `ghook keys rotate-kek` (that command cannot run when SECRETS_KEY is set).
# SECRETS_KEY=

# Protect /metrics with Authorization: Bearer <token>. Unset: /metrics returns 404.
# METRICS_TOKEN=

# Per-user quotas.
# MAX_TARGETS=25
# MAX_ROUTES=50
# MAX_DELIVERIES_PER_DAY=1000

# PUID=1000
# PGID=1000
# LOG_LEVEL=info

# Daily database compaction, local time (TZ). "off" turns it off.
# COMPACT_AT=03:15
